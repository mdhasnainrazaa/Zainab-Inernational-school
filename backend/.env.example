# =========================================================================
# ZAINAB INTERNATIONAL PUBLIC SCHOOL (ZIPS) - BACKEND ENVIRONMENT CONFIG
# =========================================================================

# 1. Server Port (Default: 5000)
PORT=5000

# 2. Environment Mode ('development' or 'production')
NODE_ENV=development

# 3. MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/zips_school_db?retryWrites=true&w=majority

# 4. JSON Web Token (JWT) Secret (Used for encrypting admin login sessions)
JWT_SECRET=zips_academic_excellence_jwt_secret_key_2026_super_secure

# 5. Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# 6. Admin Panel Credentials
# Any email & password provided here will automatically create or update the Admin in MongoDB!
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PASSWORD=YourStrongPassword123
ADMIN_NAME=ZIPS Administrator
